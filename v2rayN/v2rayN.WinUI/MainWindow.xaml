<Window
    x:Class="v2rayN.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid x:Name="AppTitleBar" Padding="12,0,0,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="16" Height="16" HorizontalAlignment="Left" Source="Assets/v2rayN.ico" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="v2rayN · WinUI 3" />
            </Grid>
        </Grid>

        <!-- Custom left nav: NavigationView selection/hit-testing is unreliable with custom title bars. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource PanelStrokeBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Height="72" Margin="16,12,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" Background="{StaticResource BrandBrush}" CornerRadius="8">
                            <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="19" Foreground="White" Glyph="&#xE774;" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe UI Variable Display" FontSize="16" FontWeight="SemiBold" Text="v2rayN" />
                            <TextBlock Foreground="{ThemeResource MutedTextBrush}" FontSize="11" Text="Modern Shell" />
                        </StackPanel>
                    </Grid>

                    <ListView
                        x:Name="NavList"
                        Grid.Row="1"
                        Margin="8,0,8,12"
                        SelectionChanged="NavList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListViewItem Tag="dashboard">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Home" />
                                <TextBlock VerticalAlignment="Center" Text="仪表盘" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="profiles">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="List" />
                                <TextBlock VerticalAlignment="Center" Text="配置项" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="subscriptions">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Sync" />
                                <TextBlock VerticalAlignment="Center" Text="订阅管理" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="logs">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Message" />
                                <TextBlock VerticalAlignment="Center" Text="运行日志" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="updates">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Download" />
                                <TextBlock VerticalAlignment="Center" Text="组件更新" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="settings">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <SymbolIcon Symbol="Setting" />
                                <TextBlock VerticalAlignment="Center" Text="设置" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="{ThemeResource AppBackgroundBrush}">
                <ScrollViewer x:Name="DashboardPage" HorizontalContentAlignment="Center" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" SizeChanged="DashboardPage_SizeChanged" VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="DashboardContentGrid" MaxWidth="1600" Padding="32,26,32,30" HorizontalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="DashboardHeaderGrid" Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup>
                                    <VisualState x:Name="NarrowDashboardHeader">
                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="HeaderStatusPanel.(Grid.Row)" Value="1" />
                                            <Setter Target="HeaderStatusPanel.(Grid.Column)" Value="0" />
                                            <Setter Target="HeaderStatusPanel.(Grid.ColumnSpan)" Value="2" />
                                            <Setter Target="HeaderStatusPanel.Margin" Value="0,12,0,0" />
                                            <Setter Target="HeaderStatusPanel.HorizontalAlignment" Value="Left" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="WideDashboardHeader">
                                        <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1180" /></VisualState.StateTriggers>
                                        <VisualState.Setters>
                                            <Setter Target="HeaderStatusPanel.(Grid.Row)" Value="0" />
                                            <Setter Target="HeaderStatusPanel.(Grid.Column)" Value="1" />
                                            <Setter Target="HeaderStatusPanel.(Grid.ColumnSpan)" Value="1" />
                                            <Setter Target="HeaderStatusPanel.Margin" Value="0" />
                                            <Setter Target="HeaderStatusPanel.HorizontalAlignment" Value="Right" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <StackPanel>
                                <TextBlock FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold" Text="仪表盘" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource QuietTextStyle}" Text="查看内核运行情况并快速调整常用开关" />
                            </StackPanel>
                            <StackPanel x:Name="HeaderStatusPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Padding="12,6" Background="{StaticResource SuccessBrush}" CornerRadius="6">
                                    <TextBlock x:Name="CoreStatusText" Foreground="White" FontWeight="SemiBold" Text="正在初始化" />
                                </Border>
                                <TextBlock x:Name="ActiveServerHeaderText" MaxWidth="320" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="StopCoreButton" Click="StopCore_Click" ToolTipService.ToolTip="停止核心">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Stop" /><TextBlock Text="停止" /></StackPanel>
                                </Button>
                                <Button x:Name="ReloadCoreButton" Click="ReloadCore_Click" ToolTipService.ToolTip="启动核心">
                                    <StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Play" /><TextBlock x:Name="ReloadCoreButtonText" Text="启动" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="MetricGrid" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="MetricColumn1" Width="*" />
                                    <ColumnDefinition x:Name="MetricColumn2" Width="*" />
                                    <ColumnDefinition x:Name="MetricColumn3" Width="*" />
                                    <ColumnDefinition x:Name="MetricColumn4" Width="*" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactMetricGrid">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="MetricColumn3.Width" Value="0" />
                                                <Setter Target="MetricColumn4.Width" Value="0" />
                                                <Setter Target="TotalTrafficCard.(Grid.Row)" Value="1" />
                                                <Setter Target="TotalTrafficCard.(Grid.Column)" Value="0" />
                                                <Setter Target="ActiveServerCard.(Grid.Row)" Value="1" />
                                                <Setter Target="ActiveServerCard.(Grid.Column)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideMetricGrid">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1180" /></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="MetricColumn3.Width" Value="*" />
                                                <Setter Target="MetricColumn4.Width" Value="*" />
                                                <Setter Target="TotalTrafficCard.(Grid.Row)" Value="0" />
                                                <Setter Target="TotalTrafficCard.(Grid.Column)" Value="2" />
                                                <Setter Target="ActiveServerCard.(Grid.Row)" Value="0" />
                                                <Setter Target="ActiveServerCard.(Grid.Column)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Style="{StaticResource PanelStyle}" Padding="20" MinHeight="138">
                                    <StackPanel Spacing="8">
                                        <Grid><TextBlock Style="{StaticResource QuietTextStyle}" Text="下载速度" /><SymbolIcon HorizontalAlignment="Right" Foreground="{StaticResource BrandBrush}" Symbol="Download" /></Grid>
                                        <TextBlock x:Name="DownloadSpeedText" Style="{StaticResource MetricValueStyle}" Text="0 B/s" />
                                        <TextBlock x:Name="DownloadTotalText" Style="{StaticResource QuietTextStyle}" Text="本次 0 B" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="138">
                                    <StackPanel Spacing="8">
                                        <Grid><TextBlock Style="{StaticResource QuietTextStyle}" Text="上传速度" /><SymbolIcon HorizontalAlignment="Right" Foreground="{StaticResource SuccessBrush}" Symbol="Upload" /></Grid>
                                        <TextBlock x:Name="UploadSpeedText" Style="{StaticResource MetricValueStyle}" Text="0 B/s" />
                                        <TextBlock x:Name="UploadTotalText" Style="{StaticResource QuietTextStyle}" Text="本次 0 B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="TotalTrafficCard" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="138">
                                    <StackPanel Spacing="8">
                                        <Grid><TextBlock Style="{StaticResource QuietTextStyle}" Text="总流量" /><SymbolIcon HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" Symbol="Globe" /></Grid>
                                        <TextBlock x:Name="TotalTrafficText" Style="{StaticResource MetricValueStyle}" Text="0 B" />
                                        <TextBlock x:Name="TotalTrafficDetailText" Style="{StaticResource QuietTextStyle}" Text="上传 0 B · 下载 0 B" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ActiveServerCard" Grid.Column="3" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="138">
                                    <StackPanel Spacing="8">
                                        <Grid><TextBlock Style="{StaticResource QuietTextStyle}" Text="当前服务器" /><SymbolIcon HorizontalAlignment="Right" Foreground="{StaticResource WarningBrush}" Symbol="Globe" /></Grid>
                                        <TextBlock x:Name="ActiveServerText" Style="{StaticResource MetricValueStyle}" FontSize="20" Text="未选择" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ActiveServerDetailText" Style="{StaticResource QuietTextStyle}" Text="-" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                        </Grid>

                        <Grid x:Name="ControlGrid" Grid.Row="2" Margin="0,12,0,0" ColumnSpacing="12" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ControlColumn1" Width="*" />
                                    <ColumnDefinition x:Name="ControlColumn2" Width="*" />
                                    <ColumnDefinition x:Name="ControlColumn3" Width="*" />
                                    <ColumnDefinition x:Name="ControlColumn4" Width="*" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup>
                                        <VisualState x:Name="CompactControlGrid">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ControlColumn3.Width" Value="0" />
                                                <Setter Target="ControlColumn4.Width" Value="0" />
                                                <Setter Target="RoutingCard.(Grid.Row)" Value="1" />
                                                <Setter Target="RoutingCard.(Grid.Column)" Value="0" />
                                                <Setter Target="OutboundIpCard.(Grid.Row)" Value="1" />
                                                <Setter Target="OutboundIpCard.(Grid.Column)" Value="1" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="WideControlGrid">
                                            <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1180" /></VisualState.StateTriggers>
                                            <VisualState.Setters>
                                                <Setter Target="ControlColumn3.Width" Value="*" />
                                                <Setter Target="ControlColumn4.Width" Value="*" />
                                                <Setter Target="RoutingCard.(Grid.Row)" Value="0" />
                                                <Setter Target="RoutingCard.(Grid.Column)" Value="2" />
                                                <Setter Target="OutboundIpCard.(Grid.Row)" Value="0" />
                                                <Setter Target="OutboundIpCard.(Grid.Column)" Value="3" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border Style="{StaticResource PanelStyle}" Padding="20" MinHeight="146">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontWeight="SemiBold" Text="系统代理" />
                                        <TextBlock Style="{StaticResource QuietTextStyle}" Text="切换操作系统代理模式" />
                                        <ComboBox x:Name="ProxyModeCombo" SelectionChanged="ProxyModeCombo_SelectionChanged">
                                            <ComboBoxItem Content="清除系统代理" Tag="0" />
                                            <ComboBoxItem Content="自动配置系统代理" Tag="1" />
                                            <ComboBoxItem Content="不改变系统代理" Tag="2" />
                                            <ComboBoxItem Content="PAC 模式" Tag="3" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="146">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontWeight="SemiBold" Text="TUN 模式" />
                                        <TextBlock Style="{StaticResource QuietTextStyle}" Text="接管设备的所有网络流量" />
                                        <ToggleSwitch x:Name="TunToggle" OffContent="关闭" OnContent="开启" Toggled="TunToggle_Toggled" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RoutingCard" Grid.Column="2" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="146">
                                    <StackPanel Spacing="10">
                                        <TextBlock FontWeight="SemiBold" Text="路由模式" />
                                        <TextBlock Style="{StaticResource QuietTextStyle}" Text="选择绕过大陆或全局规则" />
                                        <ComboBox x:Name="RoutingCombo" DisplayMemberPath="DisplayRemarks" SelectionChanged="RoutingCombo_SelectionChanged" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OutboundIpCard" Grid.Column="3" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="146">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock FontWeight="SemiBold" Text="出口 IP" />
                                            <ProgressRing x:Name="OutboundIpProgress" Width="18" Height="18" HorizontalAlignment="Right" IsActive="False" />
                                        </Grid>
                                        <TextBlock x:Name="OutboundIpDetailText" Grid.Row="1" Style="{StaticResource QuietTextStyle}" Text="等待检测" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="OutboundIpText" Grid.Row="2" FontFamily="Cascadia Mono" FontSize="20" FontWeight="SemiBold" Text="--" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="RefreshOutboundIpButton" Click="RefreshOutboundIp_Click" ToolTipService.ToolTip="重新检测出口 IP">
                                                <SymbolIcon Symbol="Refresh" />
                                            </Button>
                                            <Button x:Name="CopyOutboundIpButton" Click="CopyOutboundIp_Click" IsEnabled="False" ToolTipService.ToolTip="复制出口 IP">
                                                <SymbolIcon Symbol="Copy" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                        </Grid>

                        <Border Grid.Row="3" Margin="0,16,0,0" Style="{StaticResource PanelStyle}" Padding="20" MinHeight="300">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <TextBlock Foreground="{StaticResource SuccessBrush}" Text="● 上传" />
                                        <TextBlock Foreground="{StaticResource WarningBrush}" Text="● 下载" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource QuietTextStyle}"
                                        Text="最近 60 秒 · 速度 (B/s)" />
                                </Grid>
                                <Grid Grid.Row="1" Margin="0,14,0,0" MinHeight="220">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Y-axis labels (speed) -->
                                    <Grid x:Name="YAxisLabelPanel" Grid.Row="0" Margin="0,0,8,0">
                                        <TextBlock
                                            x:Name="YAxisTopLabel"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Text="1.0 KB/s" />
                                        <TextBlock
                                            x:Name="YAxisMidLabel"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Text="0.5 KB/s" />
                                        <TextBlock
                                            x:Name="YAxisBottomLabel"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Text="0 B/s" />
                                    </Grid>

                                    <Canvas
                                        x:Name="TrafficCanvas"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        MinHeight="200"
                                        SizeChanged="TrafficCanvas_SizeChanged">
                                        <Line x:Name="AxisBottom" Stroke="{ThemeResource PanelStrokeBrush}" StrokeThickness="1" />
                                        <Line x:Name="AxisMiddle" Stroke="{ThemeResource PanelStrokeBrush}" StrokeThickness="1" StrokeDashArray="3,4" />
                                        <Line x:Name="AxisTop" Stroke="{ThemeResource PanelStrokeBrush}" StrokeThickness="1" StrokeDashArray="3,4" />
                                        <Polyline x:Name="UploadLine" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" />
                                        <Polyline x:Name="DownloadLine" Stroke="{StaticResource WarningBrush}" StrokeThickness="2" />
                                    </Canvas>

                                    <!-- X-axis labels (time) -->
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                        <TextBlock
                                            x:Name="XAxisLeftLabel"
                                            HorizontalAlignment="Left"
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Text="-60s" />
                                        <TextBlock
                                            x:Name="XAxisMidLabel"
                                            HorizontalAlignment="Center"
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Text="-30s" />
                                        <TextBlock
                                            x:Name="XAxisRightLabel"
                                            HorizontalAlignment="Right"
                                            FontFamily="Cascadia Mono"
                                            FontSize="11"
                                            Foreground="{ThemeResource MutedTextBrush}"
                                            Text="现在" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <Grid x:Name="ProfilesPage" Visibility="Collapsed" Padding="32,26,32,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel><TextBlock Style="{StaticResource SectionTitleStyle}" FontSize="28" Text="配置项" /><TextBlock Margin="0,5,0,0" Style="{StaticResource QuietTextStyle}" Text="服务器列表与完整管理操作" /></StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="ProfileGroupCombo" Width="220" Header="订阅分组" DisplayMemberPath="Remarks" SelectionChanged="ProfileGroupCombo_SelectionChanged" />
                            <TextBox x:Name="ProfileSearchBox" Width="280" PlaceholderText="筛选名称、地址或订阅" TextChanged="ProfileSearchBox_TextChanged" />
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Margin="0,18,0,12" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Tag="add-clipboard" Click="FeatureButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Paste" /><TextBlock Text="从剪贴板导入" /></StackPanel></Button>
                            <Button Tag="add-image" Click="FeatureButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Pictures" /><TextBlock Text="从图片识别" /></StackPanel></Button>
                            <DropDownButton><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Add" /><TextBlock Text="添加服务器" /></StackPanel><DropDownButton.Flyout><MenuFlyout>
                                <MenuFlyoutItem Text="VMess" Tag="vmess" Click="AddProtocol_Click" /><MenuFlyoutItem Text="VLESS" Tag="vless" Click="AddProtocol_Click" /><MenuFlyoutItem Text="Shadowsocks" Tag="shadowsocks" Click="AddProtocol_Click" /><MenuFlyoutItem Text="SOCKS" Tag="socks" Click="AddProtocol_Click" /><MenuFlyoutItem Text="HTTP" Tag="http" Click="AddProtocol_Click" /><MenuFlyoutItem Text="Trojan" Tag="trojan" Click="AddProtocol_Click" /><MenuFlyoutItem Text="Hysteria2" Tag="hysteria2" Click="AddProtocol_Click" /><MenuFlyoutItem Text="TUIC" Tag="tuic" Click="AddProtocol_Click" /><MenuFlyoutItem Text="WireGuard" Tag="wireguard" Click="AddProtocol_Click" /><MenuFlyoutItem Text="AnyTLS" Tag="anytls" Click="AddProtocol_Click" /><MenuFlyoutItem Text="NaiveProxy" Tag="naive" Click="AddProtocol_Click" /><MenuFlyoutSeparator /><MenuFlyoutItem Text="自定义配置" Tag="custom" Click="AddProtocol_Click" /><MenuFlyoutItem Text="策略组" Tag="policy" Click="AddProtocol_Click" /><MenuFlyoutItem Text="代理链" Tag="chain" Click="AddProtocol_Click" />
                            </MenuFlyout></DropDownButton.Flyout></DropDownButton>
                            <Button Tag="edit-server" Click="FeatureButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Edit" /><TextBlock Text="编辑" /></StackPanel></Button>
                            <Button Tag="remove-server" Click="FeatureButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Delete" /><TextBlock Text="删除" /></StackPanel></Button>
                            <Button Tag="profile-activate" Click="FeatureButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Accept" /><TextBlock Text="设为活动" /></StackPanel></Button>
                            <Button Tag="tcp-ping" Click="FeatureButton_Click" Content="TCP Ping" />
                            <Button Tag="real-ping" Click="FeatureButton_Click" Content="真实延迟" />
                            <Button Tag="udp-test" Click="FeatureButton_Click" Content="UDP 测试" />
                            <Button Tag="speed-test" Click="FeatureButton_Click" Content="测速" />
                            <Button Tag="export" Click="FeatureButton_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Share" /><TextBlock Text="分享 / 导出" /></StackPanel></Button>
                            <Button Tag="copy-server" Click="FeatureButton_Click" Content="复制" />
                            <Button Tag="deduplicate" Click="FeatureButton_Click" Content="去重" />
                            <Button Tag="remove-invalid" Click="FeatureButton_Click" Content="清理无效" />
                            <Button Tag="mixed-test" Click="FeatureButton_Click" Content="综合测试" />
                            <Button Tag="fast-ping" Click="FeatureButton_Click" Content="快速延迟" />
                            <Button Tag="sort-results" Click="FeatureButton_Click" Content="按结果排序" />
                            <ComboBox x:Name="SortColumnCombo" Width="170" PlaceholderText="按列排序" SelectionChanged="SortColumnCombo_SelectionChanged"><ComboBoxItem Content="类型" Tag="ConfigType" /><ComboBoxItem Content="备注" Tag="Remarks" /><ComboBoxItem Content="地址" Tag="Address" /><ComboBoxItem Content="端口" Tag="Port" /><ComboBoxItem Content="传输" Tag="Network" /><ComboBoxItem Content="TLS" Tag="StreamSecurity" /><ComboBoxItem Content="订阅" Tag="SubRemarks" /><ComboBoxItem Content="延迟" Tag="DelayVal" /><ComboBoxItem Content="速度" Tag="SpeedVal" /><ComboBoxItem Content="今日上传" Tag="TodayUp" /><ComboBoxItem Content="今日下载" Tag="TodayDown" /><ComboBoxItem Content="总上传" Tag="TotalUp" /><ComboBoxItem Content="总下载" Tag="TotalDown" /></ComboBox>
                            <Button Tag="move-top" Click="FeatureButton_Click" Content="置顶" /><Button Tag="move-up" Click="FeatureButton_Click" Content="上移" /><Button Tag="move-down" Click="FeatureButton_Click" Content="下移" /><Button Tag="move-bottom" Click="FeatureButton_Click" Content="置底" />
                            <ComboBox x:Name="MoveGroupCombo" Width="180" PlaceholderText="移动到分组" DisplayMemberPath="Remarks" SelectionChanged="MoveGroupCombo_SelectionChanged" />
                            <Button Tag="export-client" Click="FeatureButton_Click" Content="导出客户端配置" /><Button Tag="export-client-clipboard" Click="FeatureButton_Click" Content="客户端配置到剪贴板" /><Button Tag="export-url" Click="FeatureButton_Click" Content="导出分享链接" /><Button Tag="export-base64" Click="FeatureButton_Click" Content="导出 Base64" /><Button Tag="export-inner" Click="FeatureButton_Click" Content="导出内部 URI" />
                            <Button Tag="generate-all" Click="FeatureButton_Click" Content="全部节点生成策略组" /><Button Tag="generate-region" Click="FeatureButton_Click" Content="按地区生成策略组" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid Padding="14,0" Background="{ThemeResource AccentSoftBrush}" ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Text="状态" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="类型" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="备注" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="地址" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="端口" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="传输" /><TextBlock Grid.Column="6" VerticalAlignment="Center" Text="TLS" /><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="订阅" /><TextBlock Grid.Column="8" VerticalAlignment="Center" Text="延迟" />
                            </Grid>
                            <ListView x:Name="ProfilesList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ProfilesList_ItemClick" DoubleTapped="ProfilesList_DoubleTapped" SelectionChanged="ProfilesList_SelectionChanged" SelectionMode="Extended">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid MinHeight="42" Padding="10,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="60" /><ColumnDefinition Width="110" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="1.5*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" Text="{Binding IsActive}" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding ConfigType}" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding Remarks}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" VerticalAlignment="Center" FontFamily="Cascadia Mono" Text="{Binding Address}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding Port}" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding Network}" /><TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{Binding StreamSecurity}" /><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{Binding SubRemarks}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="8" VerticalAlignment="Center" Text="{Binding DelayVal}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="ModulePage" Visibility="Collapsed" Padding="32,26,32,30">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="ModuleTitleText" Style="{StaticResource SectionTitleStyle}" FontSize="28" Text="功能" /><TextBlock x:Name="ModuleSubtitleText" Margin="0,5,0,0" Style="{StaticResource QuietTextStyle}" /></StackPanel>
                    <ContentControl x:Name="ModuleContent" Grid.Row="1" Margin="0,18,0,0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Grid>

                <InfoBar x:Name="MessageBar" Margin="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" IsClosable="True" IsOpen="False" MaxWidth="520" Severity="Informational" />
            </Grid>
        </Grid>
    </Grid>
</Window>
